# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8080

DB_URL=jdbc:postgresql://localhost:5432/bookforward
DB_USERNAME=bookforward
DB_PASSWORD=change-me

# Required: random string of 32+ characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRY_MINUTES=120

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/uploads

PAYMENT_ENABLED=false
PAYMENT_PROVIDER=offline

# Optional: creates the first admin on startup when both are set (password 8+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOG_LEVEL=INFO
# REDIS_URL=redis://localhost:6379   (reserved for future Redis adapters)
